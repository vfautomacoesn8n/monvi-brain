{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Monvi Brain Task",
  "allOf": [
    { "$ref": "note.schema.json" },
    {
      "type": "object",
      "required": [
        "type",
        "task_state",
        "agent",
        "reviewer",
        "active_client",
        "allowed_paths",
        "read_only_paths",
        "forbidden_paths",
        "requires_review",
        "acceptance_criteria"
      ],
      "properties": {
        "type": { "const": "task" },
        "task_state": {
          "type": "string",
          "enum": ["inbox", "active", "review", "blocked", "done"]
        },
        "agent": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "active_client": {
          "type": ["string", "null"],
          "minLength": 1,
          "not": { "const": "none" }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!01_RAW(?:/|$)).+" },
          "uniqueItems": true
        },
        "read_only_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requires_review": { "type": "boolean" },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_reason": { "type": ["string", "null"] }
      },
      "x-monvi-path-set-rules": {
        "description": "Extensão de governança validada pelo workflow: allowed_paths, read_only_paths e forbidden_paths devem ser mutuamente exclusivos; caminhos em 01_RAW só podem ser declarados em read_only_paths.",
        "mutually_exclusive": ["allowed_paths", "read_only_paths", "forbidden_paths"],
        "raw_paths_only_in": "read_only_paths"
      }
    }
  ]
}
